<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground del wrapper Julia Bakery POS.
  Extraido del logo.svg del repo (solo el disco del pan, sin texto ni espigas
  finas que no se leerian a tamaño de icono). Canvas 108x108 (estandar Android
  adaptive icon). Coordenadas escaladas con factor 0.375 desde el SVG original
  (centrado en (200,160) r=88 → centrado en (54,54) r=33), dejando margen en
  el safe area de 66dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Disco exterior (borde marrón claro) -->
    <path
        android:fillColor="#D4A574"
        android:strokeColor="#8B5A3C"
        android:strokeWidth="1.13"
        android:pathData="M 21 54
                          A 33 33 0 0 1 87 54
                          A 33 33 0 0 1 21 54 Z" />

    <!-- Cuerpo del pan: hogaza estilizada (centrada en 54, 57.75) -->
    <path
        android:fillColor="#F5E6D3"
        android:strokeColor="#5D3A1F"
        android:strokeWidth="0.75"
        android:pathData="M 36 57.75
                          A 18 12 0 0 1 72 57.75
                          A 18 12 0 0 1 36 57.75 Z" />

    <!-- Cortes superiores del pan (3 arcos) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#5D3A1F"
        android:strokeWidth="0.94"
        android:strokeLineCap="round"
        android:pathData="M 42.75 50.5 Q 45.75 46.75 49.5 50.5" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#5D3A1F"
        android:strokeWidth="0.94"
        android:strokeLineCap="round"
        android:pathData="M 50.25 49 Q 54 45.25 57.75 49" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#5D3A1F"
        android:strokeWidth="0.94"
        android:strokeLineCap="round"
        android:pathData="M 58.5 50.5 Q 62.25 46.75 65.25 50.5" />

    <!-- Espigas estilizadas - lado izquierdo -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#8B5A3C"
        android:strokeWidth="0.75"
        android:strokeLineCap="round"
        android:pathData="M 32.25 57.75 L 38.25 53.25
                          M 33.75 54.75 L 37.5 54
                          M 33.75 60.75 L 37.5 61.5" />

    <!-- Espigas estilizadas - lado derecho -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#8B5A3C"
        android:strokeWidth="0.75"
        android:strokeLineCap="round"
        android:pathData="M 75.75 57.75 L 69.75 53.25
                          M 74.25 54.75 L 70.5 54
                          M 74.25 60.75 L 70.5 61.5" />

</vector>
