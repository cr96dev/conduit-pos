{
  "name": "conduit-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Conduit POS — whitelabel B2B SaaS POS platform for restaurants, cafés, and bakeries in LATAM. FEL Guatemala native + Recurrente QR + pickup PWA + Loyverse migration.",
  "scripts": {
    "dev": "npm run build:pickup-css && next dev",
    "build:pickup-css": "npx tailwindcss -c tailwind.pickup.config.js -i styles/pickup-source.css -o public/pickup/styles.css --minify",
    "build": "npm run build:pickup-css && next build",
    "start": "next start",
    "migrate": "node scripts/migrate.js",
    "migrate:list": "node scripts/migrate.js --list",
    "migrate:dry": "node scripts/migrate.js --dry-run"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.43.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "14.2.3",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "undici": "^6.26.0",
    "unpdf": "^1.6.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "pg": "^8.11.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
